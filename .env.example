# =========================================================================
# Environment Variables & Configuration Template
# DevOps Practical - Step 9: Configure Environment Variables & Secrets
# =========================================================================

# Application Port (Default 8080)
PORT=8080
HOST_PORT=8080

# Environment Mode: 'development' | 'staging' | 'production'
NODE_ENV=production

# Application Versioning & Release Tracking
APP_VERSION=1.0.0
RELEASE_NAME=Genesis-Release

# Logging & Debug Mode
DEBUG=false

# MySQL Database Configuration (Local PC or AWS RDS)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=edugrade_db

# Cloud / AWS Deployment Secrets (Stored in GitHub Secrets or AWS SSM / Secrets Manager)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
# DOCKERHUB_USERNAME=devopsuser
# DOCKERHUB_TOKEN=dckr_pat_example12345

